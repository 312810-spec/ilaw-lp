{
  "name": "ilaw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked lesson design workspace for Philippine teachers",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --use-env-proxy src/server.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "check": "node scripts/check.js",
    "research": "node --use-env-proxy scripts/research.js",
    "test:e2e": "node tests/browser.js",
    "check:ai": "node --env-file-if-exists=.env --use-env-proxy scripts/ai-check.js",
    "setup:browser": "node scripts/setup-browser.js",
    "benchmark": "node --env-file-if-exists=.env --use-env-proxy scripts/benchmark.js",
    "backup": "node scripts/backup.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "image-size": "2.0.3"
  }
}
