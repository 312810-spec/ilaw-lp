# Read by deployment environment, never by the browser. Shell: set -a; source .env; set +a
NODE_USE_ENV_PROXY=1
HOST=127.0.0.1
PORT=3000
ILAW_DB_PATH=./data/ilaw.sqlite
# Optional real OpenAI-compatible provider. Guided design works without credentials.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_DESIGN_MODEL=gpt-4.1
AI_FAST_MODEL=gpt-4.1-mini
# Optional supplemental current technical documentation for teacher-selected ICT/software lessons.
# Disabled by default. The key stays server-side; learner/class context is never sent.
ILAW_CONTEXT7_TECHNICAL_REFERENCES=false
CONTEXT7_API_KEY=
# Override only when Context7's official API documentation requires a different endpoint.
CONTEXT7_SEARCH_URL=https://context7.com/api/v3/search
# Required to expose outside loopback. Use an HTTPS reverse proxy; see README.
ILAW_PUBLIC_ORIGIN=
ILAW_REGISTRATION_ENABLED=false
# Optional administrator-reviewed JSON registries. They are never guessed by AI.
ILAW_CURRICULUM_FILE=
ILAW_POLICY_FILE=

ILAW_BOW_FILE=
ILAW_OBSERVATION_TOOLS_FILE=
